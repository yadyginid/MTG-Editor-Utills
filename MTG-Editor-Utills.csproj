<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MTG-Editor-Utills</AssemblyName>
    <RootNamespace>UrukCardEditor</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="unluac.net" Version="1.1.5792.32599" />
  </ItemGroup>
  <ItemGroup>
    <None Include="tools/mdluac51.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Adding2013Version Cards/**/*.cs" />
  </ItemGroup>
</Project>
